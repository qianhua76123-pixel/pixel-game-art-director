      "steps": [
        "确定四方向站姿、同一画布和脚底锚点，先解决头、躯干、腿与脚的遮挡。",
        "先做关键姿态再补中间帧；对比时保持完整周期总时长一致，不把加帧误当成加速。",
        "记录各方向的帧标签、帧时长、待机与移动的衔接；单肩包等不对称细节逐向检查。",
        "导出精灵表及元数据，在目标引擎检查速度、触地时机、锚点漂移和首尾循环。"
      ],
      "acceptance": [
        "四向头身比例和脚底锚点相同；镜像没有错误交换装备。",
        "行走、跑步和待机能靠姿势辨认，循环首尾无停顿或跳位。",
        "动画播放速度与实际位移相符，触地阶段不滑步。"
      ]
    },
    {
