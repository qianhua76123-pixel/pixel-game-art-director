      "style_ids": [
        "cozy-rural",
        "muted-fantasy"
      ],
      "ui_style_ids": [
        "wood-paper"
      ],
      "steps": [
        "从项目参考确定可见屋顶与墙面比例、逻辑像素尺寸和主光方向；先画体块对照，避免各栋建筑自行换视角。",
        "先完成房屋、树冠、草地、岩石、水边各一个基准资产；用同一画布比例和调色板比较。",
        "从基准制作可复用边缘块与变体，记录图块尺寸、透明边距和脚底锚点。",
        "拼成最小场景，在实际显示倍率检查接缝、脚底排序、遮挡和碰撞范围。"
      ],
      "acceptance": [
        "屋顶与正面墙的投影关系一致；等距与俯视资产没有未经说明地混用。",
        "近邻素材的光源、阴影方向、轮廓粗细与细节密度协调。",
        "图块连续平铺没有突然断纹；可行走区域与视觉接地关系一致。"
      ]
    },
    {
      "id": "four-direction-character",
      "name": "四向角色与动作制作",
